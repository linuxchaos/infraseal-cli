{
  "format_version": "1.2",
  "terraform_version": "1.8.0",
  "resource_changes": [
    {
      "address": "aws_security_group_rule.app_https",
      "type": "aws_security_group_rule",
      "change": {
        "actions": ["create"],
        "after": {
          "type": "ingress",
          "from_port": 443,
          "to_port": 443,
          "cidr_blocks": ["10.0.0.0/16"]
        }
      }
    },
    {
      "address": "aws_db_instance.chat",
      "type": "aws_db_instance",
      "change": {
        "actions": ["create"],
        "after": {
          "publicly_accessible": false,
          "storage_encrypted": true
        }
      }
    }
  ]
}
