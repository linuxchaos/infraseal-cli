{
  "format_version": "1.2",
  "terraform_version": "1.8.0",
  "resource_changes": [
    {
      "address": "aws_security_group_rule.ssh",
      "type": "aws_security_group_rule",
      "change": {
        "actions": ["create"],
        "after": {
          "type": "ingress",
          "from_port": 22,
          "to_port": 22,
          "cidr_blocks": ["0.0.0.0/0"]
        }
      }
    },
    {
      "address": "aws_db_instance.chat",
      "type": "aws_db_instance",
      "change": {
        "actions": ["create"],
        "after": {
          "publicly_accessible": true,
          "storage_encrypted": false,
          "password": "demo-password"
        }
      }
    },
    {
      "address": "aws_iam_policy.agent",
      "type": "aws_iam_policy",
      "change": {
        "actions": ["create"],
        "after": {
          "policy": "{\"Statement\":[{\"Action\":\"*\",\"Resource\":\"*\"}]}"
        }
      }
    }
  ]
}
